from __future__ import annotations

from typing import Any

class IxError(Exception): ...
class IxIndexError(IxError): ...
class IxCorruptionError(IxError): ...
class IxIoError(IxError): ...
class IxRegexError(IxError): ...
class IxConfigError(IxError): ...
class IxWatcherError(IxError): ...
class IxArchiveError(IxError): ...
class LLMOSafeError(IxError): ...

class Match:
    @property
    def file_path(self) -> str: ...
    @property
    def line_number(self) -> int: ...
    @property
    def col(self) -> int: ...
    @property
    def line_content(self) -> str: ...
    @property
    def byte_offset(self) -> int: ...
    @property
    def context_before(self) -> list[str]: ...
    @property
    def context_after(self) -> list[str]: ...
    @property
    def is_binary(self) -> bool: ...
    def __repr__(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...

class SearchResult:
    @property
    def matches(self) -> list[Match]: ...
    @property
    def stats(self) -> dict[str, int]: ...

class Index:
    def __init__(self, path: str, *, cache_mb: int = 64) -> None: ...
    def search(self, pattern: str, **kwargs: object) -> SearchResult: ...
    def rebuild(
        self,
        *,
        max_file_size_mb: int = 100,
        exclude_dirs: list[str] | None = None,
    ) -> dict[str, Any]: ...
    @staticmethod
    def build(
        path: str,
        **kwargs: object,
    ) -> dict[str, Any]: ...
    def stats(self) -> dict[str, Any]: ...
    def service_status(self) -> dict[str, Any] | None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Index: ...
    def __exit__(
        self,
        exc_type: object,
        exc_value: object,
        traceback: object,
    ) -> None: ...
    @property
    def file_count(self) -> int: ...
    @property
    def trigram_count(self) -> int: ...
    @property
    def created_at(self) -> int: ...
    @property
    def path(self) -> str: ...
    @property
    def is_stale(self) -> bool: ...

class Pipeline:
    def __init__(self, objective: str) -> None: ...
    def process(self, text: str) -> dict[str, int]: ...
    def get_decision(self) -> int: ...
